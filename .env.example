# ─── ChainKit Environment Variables ───
# Copy this file to .env and fill in values.
# NEVER commit .env files or real credentials to Git.

# ─── API Server ───
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# ─── Database ───
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/chainkit

# ─── Authentication ───
API_KEY_PEPPER=

# ─── Blockchain / Testnet ───
RPC_URL=
CHAIN_ID=11155111
RECORD_REGISTRY_ADDRESS=
RELAYER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=

# ─── Dashboard ───
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── CORS ───
ALLOWED_ORIGINS=http://localhost:3000
