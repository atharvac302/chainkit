# ─── ChainKit Environment Variables ───
# Copy this file to .env and fill in values.
# NEVER commit .env files or real credentials to Git.

# ─── API Server ───
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# ─── Database ───
# Production: Use a managed PostgreSQL instance with SSL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/chainkit

# ─── Authentication ───
# Generate a cryptographically secure random string (min 32 chars)
API_KEY_PEPPER=

# ─── Admin ───
# Optional: Token for admin-level API operations
ADMIN_TOKEN=

# ─── Blockchain / Testnet ───
RPC_URL=
CHAIN_ID=11155111
RECORD_REGISTRY_ADDRESS=
RELAYER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=

# ─── Dashboard ───
# Production: Set to your deployed API URL (e.g., https://api.chainkit.dev)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── CORS ───
# Production: Set to your deployed frontend URL (never use * in production)
ALLOWED_ORIGINS=http://localhost:3000
