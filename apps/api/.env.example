# ─── ChainKit API Environment ───
# Copy this file to .env and fill in values.
# ⚠️  WARNING: Do NOT use default/example values in production!

# ─── Server ───
NODE_ENV=development
PORT=3001

# ─── Database ───
# Development: local PostgreSQL
# Production: use a managed PostgreSQL instance with SSL (e.g., Neon, Supabase, RDS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chainkit

# ─── Authentication ───
# ⚠️  REQUIRED: Generate a cryptographically secure random string (min 32 chars)
# Example: openssl rand -hex 32
API_KEY_PEPPER=

# ─── Blockchain / RPC ───
# Development: local Hardhat node
# Production: use a reliable RPC provider (Alchemy, Infura, etc.)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# ─── Smart Contracts ───
# Address of the deployed RecordRegistry contract
RECORD_REGISTRY_ADDRESS=

# ─── Relayer ───
# ⚠️  CRITICAL: Never commit real private keys. Use a vault or KMS in production.
RELAYER_PRIVATE_KEY=

# ─── CORS ───
# Production: Set to your deployed frontend URL (never use * in production)
ALLOWED_ORIGINS=http://localhost:3000

# ─── Admin ───
# Optional: Token for admin-level API operations
ADMIN_TOKEN=
