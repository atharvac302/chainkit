{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "references": [
    { "path": "packages/shared" },
    { "path": "packages/contracts" },
    { "path": "packages/sdk-typescript" },
    { "path": "packages/cli" },
    { "path": "apps/api" }
  ],
  "exclude": ["node_modules", "dist", "apps/dashboard"]
}
